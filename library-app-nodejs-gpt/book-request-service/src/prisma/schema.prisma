generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BookRequest {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  description String?
  status      RequestStatus @default(PENDING)
  requestedBy Int
  reviewedBy  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
