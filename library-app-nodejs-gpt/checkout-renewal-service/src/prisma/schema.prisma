generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Loan {
  id           String   @id @default(uuid())
  userId       String
  bookId       String
  checkoutDate DateTime @default(now())
  dueDate      DateTime
  returnDate   DateTime?
  renewCount   Int      @default(0)

  @@index([userId])
  @@index([bookId])
}
