{
  "compilerOptions": {
    "target": "ES2020",                          // Modern JS features
    "module": "CommonJS",                        // Node.js module system
    "lib": ["ES2020"],                           // Use latest ECMAScript features
    "outDir": "dist",                            // Compiled JS output directory
    "rootDir": "src",                            // Source files directory
    "strict": true,                              // Enable all strict type-checking
    "esModuleInterop": true,                     // Allow default imports from CJS modules
    "moduleResolution": "node",                  // Resolve modules using Node.js resolution
    "resolveJsonModule": true,                   // Allow importing .json files
    "skipLibCheck": true,                        // Skip type checks on library files
    "forceConsistentCasingInFileNames": true     // Enforce consistent casing in imports
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
