NODE_ENV=development
PORT=3004
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=library_notification_service
LOG_LEVEL=info

# Email configuration (for development, use a service like Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
EMAIL_FROM=noreply@library.com

# Retry policy
MAX_RETRIES=3
RETRY_DELAY_MS=5000
