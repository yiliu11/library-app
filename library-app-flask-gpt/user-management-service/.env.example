FLASK_ENV=development
SECRET_KEY=replace_with_strong_secret

# Relational DB (PostgreSQL recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/user_mgmt

# JWT verification (must match Authentication Service)
JWT_SECRET=replace_with_same_jwt_secret_as_auth_service
JWT_ALGORITHM=HS256

# Inter-service REST
REQUESTS_TIMEOUT=5
AUTH_SERVICE_URL=http://auth-service:5000
